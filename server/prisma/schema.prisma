generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  cro       String?
  signatureUrl String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issuedPatientDocuments PatientDocument[] @relation("PatientDocumentIssuer")
  uploadedDocumentAttachments PatientDocumentAttachment[] @relation("PatientDocumentAttachmentUploader")
}

model Post {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  title      String
  excerpt    String
  content    String
  category   String
  date       DateTime
  readTime   String
  image      String
  images     String[]
  author     String
  references Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  views      Int      @default(0)
}

model Appointment {
  id            Int       @id @default(autoincrement())
  patientName   String
  cpf           String?
  date          DateTime
  scheduledAt   DateTime?
  procedure     String
  notes         String
  professional  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  patientId     Int?
  appointmentType String  @default("odontologia")
  complications String?
  materials     String?
  returnDate    DateTime?
  weight        String?
  photos        String[]  @default([])
  externalLinks String[]  @default([])
  dentalNotes   Json?
  facialNotes   Json?
  price         Float?
  paymentStatus String?   @default("paid")
  status        String    @default("scheduled")
  parentAppointmentId Int? @unique
  patient       Patient?  @relation(fields: [patientId], references: [id])
  parentAppointment Appointment? @relation("AppointmentReturns", fields: [parentAppointmentId], references: [id], onDelete: SetNull)
  returnAppointment Appointment? @relation("AppointmentReturns")
  financeTransactions FinanceTransaction[]
  prescriptions Prescription[] @relation("PrescriptionOdontogramSource")

  @@index([patientId])
}

model Treatment {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  title       String
  description String
  category    String
  image       String
  content     String
  indications String[]
  benefits    String[]
  duration    Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  results     TreatmentResult[]
}

model TreatmentResult {
  id          Int       @id @default(autoincrement())
  treatmentId Int
  image       String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
}

model Story {
  id        Int       @id @default(autoincrement())
  type      String
  url       String
  title     String?
  status    String    @default("active")
  views     Int       @default(0)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Patient {
  id            Int                  @id @default(autoincrement())
  name          String
  cpf           String               @unique
  cpfIndex      String?              @unique
  phone         String?
  address       String?
  history       String?
  birthDate     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  consent       Boolean              @default(false)
  consentDate   DateTime?
  odontogram    Json?
  appointments  Appointment[]
  finance       FinanceTransaction[]
  documents     PatientDocument[]
  prescriptions Prescription[]
}

model Prescription {
  id        Int      @id @default(autoincrement())
  content   String
  date      DateTime @default(now())
  patientId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id])
  odontogramSnapshot Json?
  odontogramSourceAppointmentId Int?
  odontogramSourceAppointment Appointment? @relation("PrescriptionOdontogramSource", fields: [odontogramSourceAppointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([odontogramSourceAppointmentId])
}

model Lead {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String
  email        String?
  treatment    String?
  message      String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
  scheduledAt  DateTime?
  professional String?
  location     String?
  source       String?
  ageGroup     String?
  city         String?
  state        String?
  neighborhood String?
  latitude     Float?
  longitude    Float?
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String?
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  feeling   String?
}

model FinanceTransaction {
  id          Int      @id @default(autoincrement())
  type        String
  amount      Float
  category    String
  description String
  date        DateTime @default(now())
  patientId   Int?
  appointmentId Int? @unique
  paymentStatus String @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient? @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  receiptUrl  String?
  nfeUrl      String?

  @@index([patientId])
}

model DocumentTemplate {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  kind      String   @default("text")
  storageKey String?
  mimeType  String?
  originalName String?
  archivedAt DateTime?
  documents PatientDocument[]
}

model PatientDocument {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  date      DateTime @default(now())
  patientId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pdfUrl    String?
  storageKey String?
  patient   Patient  @relation(fields: [patientId], references: [id])
  templateId Int?
  status String @default("issued")
  issuedAt DateTime @default(now())
  issuedById Int?
  sourceKind String @default("text")
  template DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  issuedBy User? @relation("PatientDocumentIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  attachments PatientDocumentAttachment[]

  @@index([patientId])
  @@index([templateId])
  @@index([issuedById])
}

model PatientDocumentAttachment {
  id Int @id @default(autoincrement())
  patientDocumentId Int
  storageKey String
  mimeType String
  originalName String
  size Int
  createdAt DateTime @default(now())
  uploadedById Int?
  patientDocument PatientDocument @relation(fields: [patientDocumentId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("PatientDocumentAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([patientDocumentId])
  @@index([uploadedById])
}

model AnalyticsEvent {
  id           Int      @id @default(autoincrement())
  type         String   @default("pageview")
  path         String
  ip           String?
  userAgent    String?
  date         DateTime @default(now())
  location     String?
  source       String?
  city         String?
  state        String?
  neighborhood String?
  latitude     Float?
  longitude    Float?
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  resource  String
  details   String?
  ip        String?
  timestamp DateTime @default(now())
}

model PersonalTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  description String
  amount      Float
  type        String
  category    String
  date        DateTime @default(now())
  receiptUrl  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
